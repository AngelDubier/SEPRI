    user_requests: "Here is the full initial file tree for the application:\n/.gitignore\n/App.tsx\n/Home.tsx\n/NewsPage.tsx\n/components/ChatWidget.tsx\n/components/Footer.tsx\n/components/Header.tsx\n/components/PopupSystem.tsx\n/components/ui/background-paper-shaders.tsx\n/components/ui/hero.tsx\n/components/ui/moving-border.tsx\n/constants.ts\n/index.html\n/index.tsx\n/lib/utils.ts\n/metadata.json\n/migrated_prompt_history/prompt_2025-11-26T14:33:12.122Z.json\n/migrated_prompt_history/prompt_2025-11-26T14:35:39.459Z.json\n/migrated_prompt_history/prompt_2026-01-13T13:59:50.233Z.json\n/migrated_prompt_history/prompt_2026-01-13T19:35:18.536Z.json\n/migrated_prompt_history/prompt_2026-01-14T18:32:34.636Z.json\n/netlify.toml\n/netlify/functions/contact.ts\n/netlify/functions/defaults.ts\n/netlify/functions/events.ts\n/netlify/functions/forms.ts\n/netlify/functions/news.ts\n/netlify/functions/popups.ts\n/netlify/functions/quickLinks.ts\n/package.json\n/pages/AdminLogin.tsx\n/pages/EventProcessPage.tsx\n/pages/FooterPages.tsx\n/pages/Home.tsx\n/pages/NewsPage.tsx\n/services/dataService.ts\n/services/geminiService.ts\n/tailwind.config.js\n/tsconfig.json\n/tsconfig.node.json\n/types.ts\n/vite.config.ts\n\nThe following dependencies are installed:\n@google/genai: ^1.30.0\n@netlify/blobs: ^7.2.0\n@netlify/functions: ^2.6.0\n@paper-design/shaders-react: ^0.0.69\n@react-three/fiber: ^8.15.19\nclsx: ^2.1.0\nframer-motion: ^11.0.8\nlucide-react: ^0.344.0\nreact: ^18.3.1\nreact-dom: ^18.3.1\nreact-router-dom: ^6.22.3\ntailwind-merge: ^2.2.1\nthree: ^0.162.0\n\nThe following devDependencies are installed:\n@types/node: ^20.11.0\n@types/react: ^18.2.66\n@types/react-dom: ^18.2.22\n@types/three: ^0.162.0\n@vitejs/plugin-react: ^4.2.1\nautoprefixer: ^10.4.19\npostcss: ^8.4.38\ntailwindcss: ^3.4.3\ntypescript: ^5.2.2\nvite: ^5.2.0\n\nKey file contents:\n\n--- /App.tsx ---\n```typescript\nimport React, { Suspense } from \'react\';\nimport { HashRouter as Router, Routes, Route } from \'react-router-dom\';\nimport { Canvas } from \'@react-three/fiber\';\nimport Header from \'./components/Header.tsx\';\nimport Footer from \'./components/Footer.tsx\';\nimport ChatWidget from \'./components/ChatWidget.tsx\';\nimport PopupSystem from \'./components/PopupSystem.tsx\';\nimport Home from \'./pages/Home.tsx\';\nimport NewsPage from \'./pages/NewsPage.tsx\';\nimport EventProcessPage from \'./pages/EventProcessPage.tsx\';\nimport AdminLogin from \'./pages/AdminLogin.tsx\';\nimport { FormatsPage, ReportIncidentPage, DirectoryPage, PrivacyPage } from \'./pages/FooterPages.tsx\';\nimport { ShaderPlane, EnergyRing } from \'./components/ui/background-paper-shaders.tsx\';\n\n// Layout component to centrally manage global UI elements\nconst Layout: React.FC<{ children: React.ReactNode }> = ({ children }) => {\n  return (\n    <div className=\"flex flex-col min-h-screen relative\">\n      {/* Capa de Fondo Shader Global - Aplicada a toda la aplicaci\303\263n */}\n      <div className=\"fixed inset-0 z-0 pointer-events-none opacity-[0.18]\">\n        <Canvas camera={{ position: [0, 0, 5], fov: 45 }}>\n          <Suspense fallback={null}>\n            <ShaderPlane color1=\"#164E87\" color2=\"#FFB000\" />\n            <EnergyRing radius={2.8} position={[3, 2, 0]} color=\"#164E87\" />\n            <EnergyRing radius={2.0} position={[-4, -3, 0]} color=\"#FFB000\" />\n          </Suspense>\n        </Canvas>\n      </div>\n\n      <Header />\n      <PopupSystem />\n      <main className=\"flex-grow relative z-10\">\n        {children}\n      </main>\n      <ChatWidget />\n      <Footer />\n    </div>\n  );\n};\n\nconst App: React.FC = () => {\n  return (\n    <Router>\n      <Routes>\n        {/* Public Routes wrapped in Layout */}\n        <Route path=\"/\" element={<Layout><Home /></Layout>} />\n        <Route path=\"/noticias\" element={<Layout><NewsPage /></Layout>} />\n        <Route path=\"/event/:id\" element={<Layout><EventProcessPage /></Layout>} />\n        \n        {/* Footer Routes */}\n        <Route path=\"/formatos\" element={<Layout><FormatsPage /></Layout>} />\n        <Route path=\"/reportar-incidente\" element={<Layout><ReportIncidentPage /></Layout>} />\n        <Route path=\"/directorio-emergencia\" element={<Layout><DirectoryPage /></Layout>} />\n        <Route path=\"/politicas-privacidad\" element={<Layout><PrivacyPage /></Layout>} />\n        \n        {/* Admin Route (Independent layout) */}\n        <Route path=\"/admin\" element={<AdminLogin />} />\n      </Routes>\n    </Router>\n  );\n};\n\nexport default App;\n```\n\n--- /index.html ---\n```html\n<!DOCTYPE html>\n<html lang=\"es\">\n  <head>\n    <meta charset=\"UTF-8\" />\n    <link rel=\"icon\" type=\"image/x-icon\" href=\"/icono.ico\" />\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\" />\n    <title>SEPRI Distrito 22 - Seguridad y Prevenci\303\263n</title>\n    <script src=\"https://cdn.tailwindcss.com\"></script>\n    <link href=\"https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap\" rel=\"stylesheet\">\n    <script>\n      window.tailwind.config = {\n        darkMode: \"class\",\n        theme: {\n          extend: {\n            fontFamily: { sans: [\'Inter\', \'sans-serif\'] },\n            colors: {\n              sepri: {\n                dark: \'#0E2A47\',\n                medium: \'#164E87\',\n                light: \'#6BA6D8\',\n                yellow: \'#FFB000\',\n                green: \'#2ECC71\',\n                bg: \'#F2F4F7\',\n              }\n            }\n          }\n        }\n      };\n    </script>\n    <style>\n      .scrollbar-hide::-webkit-scrollbar { display: none; }\n      html, body, #root { min-height: 100vh; margin: 0; background-color: #F2F4F7; }\n      @keyframes spin { to { transform: rotate(360deg); } }\n      @keyframes fade-out { from { opacity: 1; } to { opacity: 0; } }\n      .loader-hide { animation: fade-out 0.4s ease forwards; pointer-events: none; }\n      \n      /* Animaci\303\263n para el fondo del Hero */\n      @keyframes hero-shimmer {\n        0% { background-position: 0% 50%; }\n        50% { background-position: 100% 50%; }\n        100% { background-position: 0% 50%; }\n      }\n      .animate-hero-shimmer {\n        background-size: 200% 200%;\n        animation: hero-shimmer 5s ease infinite;\n      }\n    </style>\n    <script type=\"importmap\">\n{\n  \"imports\": {\n    \"react\": \"https://esm.sh/react@18.3.1\",\n    \"react-dom\": \"https://esm.sh/react-dom@18.3.1\",\n    \"react-dom/client\": \"https://esm.sh/react-dom@18.3.1/client\",\n    \"react/jsx-runtime\": \"https://esm.sh/react@18.3.1/jsx-runtime\",\n    \"lucide-react\": \"https://esm.sh/lucide-react@0.344.0?deps=react@18.3.1\",\n    \"react-router-dom\": \"https://esm.sh/react-router-dom@6.22.3?deps=react@18.3.1\",\n    \"framer-motion\": \"https://esm.sh/framer-motion@11.0.8?deps=react@18.3.1\",\n    \"clsx\": \"https://esm.sh/clsx@2.1.0\",\n    \"tailwind-merge\": \"https://esm.sh/tailwind-merge@2.2.1\",\n    \"@google/genai\": \"https://esm.sh/@google/genai@1.30.0\",\n    \"@paper-design/shaders-react\": \"https://esm.sh/@paper-design/shaders-react@0.0.69?deps=react@18.3.1\",\n    \"three\": \"https://esm.sh/three@0.162.0\",\n    \"@react-three/fiber\": \"https://esm.sh/@react-three/fiber@8.15.19?deps=react@18.3.1,three@0.162.0\",\n    \"react-dom/\": \"https://esm.sh/react-dom@^19.2.3/\",\n    \"react/\": \"https://esm.sh/react@^19.2.3/\",\n    \"vite\": \"https://esm.sh/vite@^7.3.1\",\n    \"@vitejs/plugin-react\": \"https://esm.sh/@vitejs/plugin-react@^5.1.2\",\n    \"@netlify/blobs\": \"https://esm.sh/@netlify/blobs@^10.5.0\",\n    \"@netlify/functions\": \"https://esm.sh/@netlify/functions@^5.1.2\"\n  }\n}\n</script>\n  </head>\n  <body class=\"bg-sepri-bg text-sepri-dark font-sans antialiased\">\n    <div id=\"root\"></div>\n    \n    <div id=\"app-initial-loader\" style=\"position:fixed; inset:0; z-index:9999; display:flex; flex-direction:column; align-items:center; justify-content:center; background-color:#F2F4F7; transition: opacity 0.4s ease;\">\n      <div style=\"width:48px; height:48px; border:4px solid #164E87; border-top-color:#FFB000; border-radius:50%; animation: spin 1s linear infinite;\"></div>\n      <p style=\"margin-top:24px; color:#164E87; font-weight:800; font-family:sans-serif; letter-spacing:0.05em; text-transform: uppercase;\">SEPRI DISTRITO 22</p>\n    </div>\n\n    <script type=\"module\" src=\"./index.tsx\"></script>\n  </body>\n</html>\n```\n\n--- /metadata.json ---\n```json\n{\n  \"name\": \"SEPRI Distrito 22\",\n  \"description\": \"Plataforma de gesti\303\263n de protocolos de seguridad y prevenci\303\263n del riesgo para el Distrito 22 de la IPUC.\",\n  \"requestFramePermissions\": []\n}\n```\n\n--- /tsconfig.json ---\n```json\n{\n  \"compilerOptions\": {\n    \"target\": \"ES2020\",\n    \"useDefineForClassFields\": true,\n    \"lib\": [\"ES2020\", \"DOM\", \"DOM.Iterable\"],\n    \"module\": \"ESNext\",\n    \"skipLibCheck\": true,\n\n    /* Bundler mode */\n    \"moduleResolution\": \"bundler\",\n    \"allowImportingTsExtensions\": true,\n    \"resolveJsonModule\": true,\n    \"isolatedModules\": true,\n    \"noEmit\": true,\n    \"jsx\": \"react-jsx\",\n\n    /* Linting */\n    \"strict\": true,\n    \"noUnusedLocals\": false,\n    \"noUnusedParameters\": false,\n    \"noFallthroughCasesInSwitch\": true\n  },\n  \"include\": [\"./**/*.ts\", \"./**/*.tsx\"],\n  \"exclude\": [\"node_modules\", \"dist\", \"vite.config.ts\"],\n  \"references\": [{ \"path\": \"./tsconfig.node.json\" }]\n}\n```\n\n--- /vite.config.ts ---\n```typescript\nimport { defineConfig } from \'vite\';\nimport react from \'@vitejs/plugin-react\';\n\n// https://vitejs.dev/config/\nexport default defineConfig({\n  plugins: [react()],\n  // Vite expone autom\303\241ticamente las variables que comienzan con VITE_ en import.meta.env\n});\n```"

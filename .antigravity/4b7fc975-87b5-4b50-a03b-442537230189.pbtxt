          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "                    <select className=\"border p-2 rounded\" value={currentNews.category || \'Novedad\'} onChange={e => setCurrentNews(prev => ({...prev, category: e.target.value as any}))}>"

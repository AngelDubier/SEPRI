    end_line: 154
    content: "\nimport { ContactInfo, Step } from \'./types\';\n\nexport const CONTACT_EMAIL = \"distrito22a@ipuc.org.co\";\nexport const COORDINATOR_PHONE = \"3233589608\";\nexport const ASSISTANT_PHONE = \"3103922530\";\n\nexport const NEWS_CAROUSEL_INTERVAL = 5000;\n\nexport const ADMIN_CREDENTIALS = {\n  username: \'distrito22a@ipuc.org.co\',\n  password: \'S3cur3#Admin!2025\', \n  role: \'ADMIN\' as const\n};\n\n// CREATOR_CREDENTIALS for the system creator role as used in dataService.ts\nexport const CREATOR_CREDENTIALS = {\n  username: \'sepri.creator@ipuc.org.co\',\n  password: \'System#Creator!2025\',\n  role: \'CREATOR\' as const\n};\n\nexport const DEFAULT_CONTACT_INFO: ContactInfo = {\n  coordinatorName: \"Juan Felipe Vera G\303\263mez\",\n  coordinatorPhone: \"3233589608\",\n  assistantName: \"Dubanier Medina Ru\303\255z\",\n  assistantPhone: \"3103922530\",\n  email: \"distrito22a@ipuc.org.co\",\n  address: \"Sede Administrativa Distrito 22, Colombia\",\n  facebookUrl: \"https://facebook.com\",\n  instagramUrl: \"https://instagram.com\",\n  youtubeUrl: \"https://youtube.com\",\n  logoUrl: \"\",\n  heroImageUrl: \"\",\n  privacyPolicy: \"La Iglesia Pentecostal Unida de Colombia - Distrito 22, a trav\303\251s de su \303\241rea SEPRI, est\303\241 comprometida con la protecci\303\263n de sus datos personales. Los datos recolectados se utilizan exclusivamente para la gesti\303\263n de protocolos de seguridad y prevenci\303\263n.\",\n  teamMembers: [\n    { id: \'1\', name: \'Juan Felipe Vera\', role: \'Coordinador SEPRI D22\', order: 0 },\n    { id: \'2\', name: \'Dubanier Medina\', role: \'Asistente Coordinaci\303\263n\', order: 1 }\n  ]\n};\n\nexport const SYSTEM_INSTRUCTION = `\nEres \"SEPRI\", el asistente virtual de Seguridad y Prevenci\303\263n del Riesgo del Distrito 22 de la Iglesia Pentecostal Unida de Colombia.\nTu misi\303\263n es ayudar a pastores y l\303\255deres a gestionar la seguridad de sus eventos.\nResponde de manera profesional, emp\303\241tica y clara. Utiliza la informaci\303\263n de protocolos disponibles para guiar a los usuarios.\n`;\n\n// NEWS_DATA for initial seeding and fallback\nexport const NEWS_DATA = [\n  {\n    id: \'1\',\n    title: \'Actualizaci\303\263n de Protocolos 2025\',\n    date: \'22 de Agosto, 2024\',\n    category: \'Importante\' as const,\n    summary: \'Se han actualizado las gu\303\255as para eventos masivos y campamentos. Es obligatorio el uso de los nuevos formatos de p\303\263lizas.\'\n  },\n  {\n    id: \'2\',\n    title: \'Mejora en Extintores Sede Distrital\',\n    date: \'15 de Julio, 2024\',\n    category: \'Novedad\' as const,\n    summary: \'Se realiz\303\263 la recarga y mantenimiento certificado de todos los extintores de la sede administrativa, cumpliendo con la norma NTC.\'\n  },\n  {\n    id: \'3\',\n    title: \'Capacitaci\303\263n de Primeros Auxilios\',\n    date: \'10 de Septiembre, 2024\',\n    category: \'Evento\' as const,\n    summary: \'Jornada de capacitaci\303\263n con la Cruz Roja para l\303\255deres locales de SEPRI. Inscripciones abiertas.\'\n  }\n];\n\n// EVENTS_DATA for initial seeding of protocol types\nexport const EVENTS_DATA = [\n  {\n    id: \'transporte\',\n    title: \'Transporte y Log\303\255stica\',\n    iconName: \'Bus\',\n    description: \'Protocolos para caravanas, rutas y contrataci\303\263n de veh\303\255culos.\',\n    baseSteps: [\n      { id: \'doc-vehiculo\', title: \'Documentaci\303\263n del Veh\303\255culo\', description: \'Recopilar Tarjeta de Propiedad, SOAT vigente y Revisi\303\263n Tecnomec\303\241nica.\', deadline: \'15 d\303\255as antes\', isDownloadable: true, downloadUrl: \'\', order: 0 },\n      { id: \'doc-conductor\', title: \'Documentaci\303\263n del Conductor\', description: \'Copia de C\303\251dula y Licencia de Conducci\303\263n vigente categor\303\255a apropiada.\', deadline: \'15 d\303\255as antes\', isDownloadable: true, downloadUrl: \'\', order: 1 }\n    ],\n    questions: [\n      { id: \'is-public-transport\', text: \'\302\277El transporte es contratado con una empresa p\303\272blica?\', triggerSteps: [\'rut-empresa\', \'poliza-contractual\'], isEnabled: true }\n    ]\n  },\n  {\n    id: \'campamentos\',\n    title: \'Campamentos y Retiros\',\n    iconName: \'Tent\',\n    description: \'Gesti\303\263n de seguridad para eventos fuera del templo, fincas y hoteles.\',\n    baseSteps: [\n      { id: \'auth-directivos\', title: \'Autorizaci\303\263n Directivos\', description: \'Enviar solicitud al correo del distrito.\', deadline: \'2 Meses antes\', isDownloadable: true, downloadUrl: \'\', order: 0 },\n      { id: \'plan-contingencia\', title: \'Plan de Contingencia\', description: \'Documento de ruta de evacuaci\303\263n y emergencias del lugar.\', requiresUpload: true, isDownloadable: true, downloadUrl: \'\', order: 1 },\n      { id: \'listado-asistentes\', title: \'Listado de Asistentes\', description: \'Formato Excel con datos de contacto y EPS de todos los participantes.\', isDownloadable: true, downloadUrl: \'\', order: 2 }\n    ],\n    questions: [\n      { id: \'has-food\', text: \'\302\277Se manipular\303\241n alimentos en el sitio?\', triggerSteps: [\'cert-manipulacion\'], isEnabled: true },\n      { id: \'has-pool\', text: \'\302\277El lugar cuenta con piscina o zonas h\303\272medas?\', triggerSteps: [\'salvavidas\'], isEnabled: true }\n    ]\n  },\n  {\n    id: \'masivos\',\n    title: \'Eventos Masivos (>500)\',\n    iconName: \'Users\',\n    description: \'Convenciones, confraternidades y conciertos con alto aforo.\',\n    baseSteps: [\n      { id: \'viabilidad\', title: \'Formato de Viabilidad\', description: \'Diligenciar formato dise\303\261ado por jur\303\255dica nacional.\', deadline: \'2 Meses antes\', isDownloadable: true, downloadUrl: \'\', order: 0 },\n      { id: \'organismos\', title: \'Notificaci\303\263n Organismos de Socorro\', description: \'Carta a Bomberos, Defensa Civil o Cruz Roja.\', deadline: \'1 Mes antes\', isDownloadable: true, downloadUrl: \'\', order: 1 }\n    ],\n    questions: [\n      { id: \'over-500\', text: \'\302\277El aforo supera las 500 personas?\', triggerSteps: [\'poliza-extra\'], isEnabled: true }\n    ]\n  }\n];\n\n// DEFAULT_POPUPS for notification system initialization\nexport const DEFAULT_POPUPS = [\n  { id: \'welcome-alert\', title: \'\302\241Aviso Importante!\', content: \'Recuerda enviar las p\303\263lizas con 30 d\303\255as de anticipaci\303\263n para eventos masivos.\', isEnabled: true, type: \'info\' as const },\n  { id: \'weather-alert\', title: \'Alerta Clim\303\241tica\', content: \'Por temporada de lluvias, revisa el estado de techos y carpas antes de tu evento.\', isEnabled: false, type: \'warning\' as const }\n];\n\n// DEFAULT_FORMS for interactive step forms\nexport const DEFAULT_FORMS = [\n  {\n    id: \'form-reporte-incidente\',\n    eventId: \'campamentos\',\n    title: \'Reporte de Novedades\',\n    description: \'Formulario para reportar incidentes menores durante el campamento.\',\n    fields: [\n      { id: \'f1\', label: \'Nombre del Responsable\', type: \'text\' as const, required: true },\n      { id: \'f2\', label: \'Descripci\303\263n del suceso\', type: \'textarea\' as const, required: true },\n      { id: \'f3\', label: \'\302\277Hubo lesionados?\', type: \'checkbox\' as const }\n    ]\n  }\n];\n\n// DEFAULT_QUICK_LINKS for global footer\nexport const DEFAULT_QUICK_LINKS = [\n  { id: \'ql-1\', title: \'Descargar Formatos\', url: \'/formatos\', isEnabled: true },\n  { id: \'ql-2\', title: \'Reportar Incidente\', url: \'/reportar-incidente\', isEnabled: true },\n  { id: \'ql-3\', title: \'Directorio de Emergencia\', url: \'/directorio-emergencia\', isEnabled: true },\n  { id: \'ql-4\', title: \'Pol\303\255tica de Privacidad\', url: \'/politicas-privacidad\', isEnabled: true },\n];\n\n// EXTRA_STEPS for conditional fulfillment path logic in EventProcessPage\nexport const EXTRA_STEPS: Record<string, Partial<Step>> = {\n  \'rut-empresa\': { id: \'rut-empresa\', title: \'RUT de la Empresa\', description: \'Copia del RUT actualizado de la empresa de transporte.\', isDownloadable: false },\n  \'poliza-contractual\': { id: \'poliza-contractual\', title: \'P\303\263liza Contractual\', description: \'Certificado de p\303\263liza de responsabilidad civil contractual.\', isDownloadable: false },\n  \'cert-manipulacion\': { id: \'cert-manipulacion\', title: \'Curso de Manipulaci\303\263n\', description: \'Certificado vigente de manipulaci\303\263n de alimentos.\', isDownloadable: false },\n  \'salvavidas\': { id: \'salvavidas\', title: \'Certificado Salvavidas\', description: \'Certificaci\303\263n del personal salvavidas de la piscina.\', isDownloadable: false },\n  \'poliza-extra\': { id: \'poliza-extra\', title: \'P\303\263liza Extracontractual\', description: \'P\303\263liza de responsabilidad civil extracontractual para eventos masivos.\', isDownloadable: false }\n};\n"
    raw_content: "\nimport { ContactInfo, Step } from \'./types\';\n\nexport const CONTACT_EMAIL = \"distrito22a@ipuc.org.co\";\nexport const COORDINATOR_PHONE = \"3233589608\";\nexport const ASSISTANT_PHONE = \"3103922530\";\n\nexport const NEWS_CAROUSEL_INTERVAL = 5000;\n\nexport const ADMIN_CREDENTIALS = {\n  username: \'distrito22a@ipuc.org.co\',\n  password: \'S3cur3#Admin!2025\', \n  role: \'ADMIN\' as const\n};\n\n// CREATOR_CREDENTIALS for the system creator role as used in dataService.ts\nexport const CREATOR_CREDENTIALS = {\n  username: \'sepri.creator@ipuc.org.co\',\n  password: \'System#Creator!2025\',\n  role: \'CREATOR\' as const\n};\n\nexport const DEFAULT_CONTACT_INFO: ContactInfo = {\n  coordinatorName: \"Juan Felipe Vera G\303\263mez\",\n  coordinatorPhone: \"3233589608\",\n  assistantName: \"Dubanier Medina Ru\303\255z\",\n  assistantPhone: \"3103922530\",\n  email: \"distrito22a@ipuc.org.co\",\n  address: \"Sede Administrativa Distrito 22, Colombia\",\n  facebookUrl: \"https://facebook.com\",\n  instagramUrl: \"https://instagram.com\",\n  youtubeUrl: \"https://youtube.com\",\n  logoUrl: \"\",\n  heroImageUrl: \"\",\n  privacyPolicy: \"La Iglesia Pentecostal Unida de Colombia - Distrito 22, a trav\303\251s de su \303\241rea SEPRI, est\303\241 comprometida con la protecci\303\263n de sus datos personales. Los datos recolectados se utilizan exclusivamente para la gesti\303\263n de protocolos de seguridad y prevenci\303\263n.\",\n  teamMembers: [\n    { id: \'1\', name: \'Juan Felipe Vera\', role: \'Coordinador SEPRI D22\', order: 0 },\n    { id: \'2\', name: \'Dubanier Medina\', role: \'Asistente Coordinaci\303\263n\', order: 1 }\n  ]\n};\n\nexport const SYSTEM_INSTRUCTION = `\nEres \"SEPRI\", el asistente virtual de Seguridad y Prevenci\303\263n del Riesgo del Distrito 22 de la Iglesia Pentecostal Unida de Colombia.\nTu misi\303\263n es ayudar a pastores y l\303\255deres a gestionar la seguridad de sus eventos.\nResponde de manera profesional, emp\303\241tica y clara. Utiliza la informaci\303\263n de protocolos disponibles para guiar a los usuarios.\n`;\n\n// NEWS_DATA for initial seeding and fallback\nexport const NEWS_DATA = [\n  {\n    id: \'1\',\n    title: \'Actualizaci\303\263n de Protocolos 2025\',\n    date: \'22 de Agosto, 2024\',\n    category: \'Importante\' as const,\n    summary: \'Se han actualizado las gu\303\255as para eventos masivos y campamentos. Es obligatorio el uso de los nuevos formatos de p\303\263lizas.\'\n  },\n  {\n    id: \'2\',\n    title: \'Mejora en Extintores Sede Distrital\',\n    date: \'15 de Julio, 2024\',\n    category: \'Novedad\' as const,\n    summary: \'Se realiz\303\263 la recarga y mantenimiento certificado de todos los extintores de la sede administrativa, cumpliendo con la norma NTC.\'\n  },\n  {\n    id: \'3\',\n    title: \'Capacitaci\303\263n de Primeros Auxilios\',\n    date: \'10 de Septiembre, 2024\',\n    category: \'Evento\' as const,\n    summary: \'Jornada de capacitaci\303\263n con la Cruz Roja para l\303\255deres locales de SEPRI. Inscripciones abiertas.\'\n  }\n];\n\n// EVENTS_DATA for initial seeding of protocol types\nexport const EVENTS_DATA = [\n  {\n    id: \'transporte\',\n    title: \'Transporte y Log\303\255stica\',\n    iconName: \'Bus\',\n    description: \'Protocolos para caravanas, rutas y contrataci\303\263n de veh\303\255culos.\',\n    baseSteps: [\n      { id: \'doc-vehiculo\', title: \'Documentaci\303\263n del Veh\303\255culo\', description: \'Recopilar Tarjeta de Propiedad, SOAT vigente y Revisi\303\263n Tecnomec\303\241nica.\', deadline: \'15 d\303\255as antes\', isDownloadable: true, downloadUrl: \'\', order: 0 },\n      { id: \'doc-conductor\', title: \'Documentaci\303\263n del Conductor\', description: \'Copia de C\303\251dula y Licencia de Conducci\303\263n vigente categor\303\255a apropiada.\', deadline: \'15 d\303\255as antes\', isDownloadable: true, downloadUrl: \'\', order: 1 }\n    ],\n    questions: [\n      { id: \'is-public-transport\', text: \'\302\277El transporte es contratado con una empresa p\303\272blica?\', triggerSteps: [\'rut-empresa\', \'poliza-contractual\'], isEnabled: true }\n    ]\n  },\n  {\n    id: \'campamentos\',\n    title: \'Campamentos y Retiros\',\n    iconName: \'Tent\',\n    description: \'Gesti\303\263n de seguridad para eventos fuera del templo, fincas y hoteles.\',\n    baseSteps: [\n      { id: \'auth-directivos\', title: \'Autorizaci\303\263n Directivos\', description: \'Enviar solicitud al correo del distrito.\', deadline: \'2 Meses antes\', isDownloadable: true, downloadUrl: \'\', order: 0 },\n      { id: \'plan-contingencia\', title: \'Plan de Contingencia\', description: \'Documento de ruta de evacuaci\303\263n y emergencias del lugar.\', requiresUpload: true, isDownloadable: true, downloadUrl: \'\', order: 1 },\n      { id: \'listado-asistentes\', title: \'Listado de Asistentes\', description: \'Formato Excel con datos de contacto y EPS de todos los participantes.\', isDownloadable: true, downloadUrl: \'\', order: 2 }\n    ],\n    questions: [\n      { id: \'has-food\', text: \'\302\277Se manipular\303\241n alimentos en el sitio?\', triggerSteps: [\'cert-manipulacion\'], isEnabled: true },\n      { id: \'has-pool\', text: \'\302\277El lugar cuenta con piscina o zonas h\303\272medas?\', triggerSteps: [\'salvavidas\'], isEnabled: true }\n    ]\n  },\n  {\n    id: \'masivos\',\n    title: \'Eventos Masivos (>500)\',\n    iconName: \'Users\',\n    description: \'Convenciones, confraternidades y conciertos con alto aforo.\',\n    baseSteps: [\n      { id: \'viabilidad\', title: \'Formato de Viabilidad\', description: \'Diligenciar formato dise\303\261ado por jur\303\255dica nacional.\', deadline: \'2 Meses antes\', isDownloadable: true, downloadUrl: \'\', order: 0 },\n      { id: \'organismos\', title: \'Notificaci\303\263n Organismos de Socorro\', description: \'Carta a Bomberos, Defensa Civil o Cruz Roja.\', deadline: \'1 Mes antes\', isDownloadable: true, downloadUrl: \'\', order: 1 }\n    ],\n    questions: [\n      { id: \'over-500\', text: \'\302\277El aforo supera las 500 personas?\', triggerSteps: [\'poliza-extra\'], isEnabled: true }\n    ]\n  }\n];\n\n// DEFAULT_POPUPS for notification system initialization\nexport const DEFAULT_POPUPS = [\n  { id: \'welcome-alert\', title: \'\302\241Aviso Importante!\', content: \'Recuerda enviar las p\303\263lizas con 30 d\303\255as de anticipaci\303\263n para eventos masivos.\', isEnabled: true, type: \'info\' as const },\n  { id: \'weather-alert\', title: \'Alerta Clim\303\241tica\', content: \'Por temporada de lluvias, revisa el estado de techos y carpas antes de tu evento.\', isEnabled: false, type: \'warning\' as const }\n];\n\n// DEFAULT_FORMS for interactive step forms\nexport const DEFAULT_FORMS = [\n  {\n    id: \'form-reporte-incidente\',\n    eventId: \'campamentos\',\n    title: \'Reporte de Novedades\',\n    description: \'Formulario para reportar incidentes menores durante el campamento.\',\n    fields: [\n      { id: \'f1\', label: \'Nombre del Responsable\', type: \'text\' as const, required: true },\n      { id: \'f2\', label: \'Descripci\303\263n del suceso\', type: \'textarea\' as const, required: true },\n      { id: \'f3\', label: \'\302\277Hubo lesionados?\', type: \'checkbox\' as const }\n    ]\n  }\n];\n\n// DEFAULT_QUICK_LINKS for global footer\nexport const DEFAULT_QUICK_LINKS = [\n  { id: \'ql-1\', title: \'Descargar Formatos\', url: \'/formatos\', isEnabled: true },\n  { id: \'ql-2\', title: \'Reportar Incidente\', url: \'/reportar-incidente\', isEnabled: true },\n  { id: \'ql-3\', title: \'Directorio de Emergencia\', url: \'/directorio-emergencia\', isEnabled: true },\n  { id: \'ql-4\', title: \'Pol\303\255tica de Privacidad\', url: \'/politicas-privacidad\', isEnabled: true },\n];\n\n// EXTRA_STEPS for conditional fulfillment path logic in EventProcessPage\nexport const EXTRA_STEPS: Record<string, Partial<Step>> = {\n  \'rut-empresa\': { id: \'rut-empresa\', title: \'RUT de la Empresa\', description: \'Copia del RUT actualizado de la empresa de transporte.\', isDownloadable: false },\n  \'poliza-contractual\': { id: \'poliza-contractual\', title: \'P\303\263liza Contractual\', description: \'Certificado de p\303\263liza de responsabilidad civil contractual.\', isDownloadable: false },\n  \'cert-manipulacion\': { id: \'cert-manipulacion\', title: \'Curso de Manipulaci\303\263n\', description: \'Certificado vigente de manipulaci\303\263n de alimentos.\', isDownloadable: false },\n  \'salvavidas\': { id: \'salvavidas\', title: \'Certificado Salvavidas\', description: \'Certificaci\303\263n del personal salvavidas de la piscina.\', isDownloadable: false },\n  \'poliza-extra\': { id: \'poliza-extra\', title: \'P\303\263liza Extracontractual\', description: \'P\303\263liza de responsabilidad civil extracontractual para eventos masivos.\', isDownloadable: false }\n};\n"

      target_content: "            {/* Top Cards */}\n            <div className=\"grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-4\">\n              <div className=\"bg-white p-6 rounded-2xl border shadow-sm flex flex-col justify-between\">\n                <div className=\"flex justify-between items-start mb-4\">\n                  <div className=\"p-3 bg-blue-50 text-blue-600 rounded-xl\"><Users size={24} /></div>\n                  <span className=\"text-xs font-bold text-green-500 bg-green-50 px-2 py-1 rounded-md\">+12.5%</span>\n                </div>\n                <div>\n                  <h4 className=\"text-gray-500 text-sm font-medium\">Visitas Totales</h4>\n                  <p className=\"text-3xl font-black text-sepri-dark\">{mockTrafficData.reduce((acc, curr) => acc + curr.visitas, 0).toLocaleString()}</p>\n                </div>\n              </div>\n              <div className=\"bg-white p-6 rounded-2xl border shadow-sm flex flex-col justify-between\">\n                <div className=\"flex justify-between items-start mb-4\">\n                  <div className=\"p-3 bg-indigo-50 text-indigo-600 rounded-xl\"><Activity size={24} /></div>\n                  <span className=\"text-xs font-bold text-green-500 bg-green-50 px-2 py-1 rounded-md\">+5.2%</span>\n                </div>\n                <div>\n                  <h4 className=\"text-gray-500 text-sm font-medium\">Usuarios \303\232nicos</h4>\n                  <p className=\"text-3xl font-black text-sepri-dark\">{mockTrafficData.reduce((acc, curr) => acc + curr.unicos, 0).toLocaleString()}</p>\n                </div>\n              </div>\n              <div className=\"bg-white p-6 rounded-2xl border shadow-sm flex flex-col justify-between\">\n                <div className=\"flex justify-between items-start mb-4\">\n                  <div className=\"p-3 bg-orange-50 text-orange-600 rounded-xl\"><Clock size={24} /></div>\n                  <span className=\"text-xs font-bold text-red-500 bg-red-50 px-2 py-1 rounded-md\">-1.1%</span>\n                </div>\n                <div>\n                  <h4 className=\"text-gray-500 text-sm font-medium\">Tiempo Promedio</h4>\n                  <p className=\"text-3xl font-black text-sepri-dark\">04:32 <span className=\"text-sm font-medium text-gray-400\">min</span></p>\n                </div>\n              </div>\n              <div className=\"bg-white p-6 rounded-2xl border shadow-sm flex flex-col justify-between\">\n                <div className=\"flex justify-between items-start mb-4\">\n                  <div className=\"p-3 bg-green-50 text-green-600 rounded-xl\"><Download size={24} /></div>\n                  <span className=\"text-xs font-bold text-green-500 bg-green-50 px-2 py-1 rounded-md\">+18.4%</span>\n                </div>\n                <div>\n                  <h4 className=\"text-gray-500 text-sm font-medium\">Descargas Totales</h4>\n                  <p className=\"text-3xl font-black text-sepri-dark\">{MOCK_DOWNLOADS_DATA.reduce((acc, curr) => acc + curr.downloads, 0).toLocaleString()}</p>\n                </div>\n              </div>\n            </div>\n\n            {/* Charts Row */}\n            <div className=\"grid grid-cols-1 lg:grid-cols-3 gap-6\">\n              {/* Main Traffic Chart */}\n              <div className=\"lg:col-span-2 bg-white p-6 rounded-2xl border shadow-sm\">\n                <h3 className=\"font-bold text-lg mb-6 text-sepri-dark\">Tr\303\241fico a lo largo del tiempo</h3>\n                <div className=\"h-80 w-full\">\n                  <ResponsiveContainer width=\"100%\" height=\"100%\">\n                    <AreaChart data={mockTrafficData} margin={{ top: 10, right: 10, left: -20, bottom: 0 }}>\n                      <defs>\n                        <linearGradient id=\"colorVisitas\" x1=\"0\" y1=\"0\" x2=\"0\" y2=\"1\">\n                          <stop offset=\"5%\" stopColor=\"#164E87\" stopOpacity={0.3}/>\n                          <stop offset=\"95%\" stopColor=\"#164E87\" stopOpacity={0}/>\n                        </linearGradient>\n                        <linearGradient id=\"colorUnicos\" x1=\"0\" y1=\"0\" x2=\"0\" y2=\"1\">\n                          <stop offset=\"5%\" stopColor=\"#FFB000\" stopOpacity={0.3}/>\n                          <stop offset=\"95%\" stopColor=\"#FFB000\" stopOpacity={0}/>\n                        </linearGradient>\n                      </defs>\n                      <CartesianGrid strokeDasharray=\"3 3\" vertical={false} stroke=\"#E5E7EB\" />\n                      <XAxis dataKey=\"date\" axisLine={false} tickLine={false} tick={{ fontSize: 12, fill: \'#6B7280\' }} dy={10} />\n                      <YAxis axisLine={false} tickLine={false} tick={{ fontSize: 12, fill: \'#6B7280\' }} />\n                      <RechartsTooltip \n                        contentStyle={{ borderRadius: \'12px\', border: \'none\', boxShadow: \'0 10px 15px -3px rgb(0 0 0 / 0.1)\' }}\n                        labelStyle={{ fontWeight: \'bold\', color: \'#374151\', marginBottom: \'8px\' }}\n                      />\n                      <Area type=\"monotone\" dataKey=\"visitas\" name=\"Visitas\" stroke=\"#164E87\" strokeWidth={3} fillOpacity={1} fill=\"url(#colorVisitas)\" />\n                      <Area type=\"monotone\" dataKey=\"unicos\" name=\"Usuarios \303\232nicos\" stroke=\"#FFB000\" strokeWidth={3} fillOpacity={1} fill=\"url(#colorUnicos)\" />\n                    </AreaChart>\n                  </ResponsiveContainer>\n                </div>\n              </div>\n\n              {/* Locations Pie Chart */}\n              <div className=\"bg-white p-6 rounded-2xl border shadow-sm\">\n                <h3 className=\"font-bold text-lg mb-6 text-sepri-dark flex items-center gap-2\"><Map size={20} className=\"text-sepri-medium\"/> Origen del Tr\303\241fico</h3>\n                <div className=\"h-56 w-full\">\n                  <ResponsiveContainer width=\"100%\" height=\"100%\">\n                    <PieChart>\n                      <Pie\n                        data={MOCK_LOCATION_DATA}\n                        cx=\"50%\"\n                        cy=\"50%\"\n                        innerRadius={60}\n                        outerRadius={80}\n                        paddingAngle={5}\n                        dataKey=\"value\"\n                      >\n                        {MOCK_LOCATION_DATA.map((entry, index) => (\n                          <Cell key={`cell-${index}`} fill={COLORS[index % COLORS.length]} />\n                        ))}\n                      </Pie>\n                      <RechartsTooltip \n                        contentStyle={{ borderRadius: \'12px\', border: \'none\', boxShadow: \'0 10px 15px -3px rgb(0 0 0 / 0.1)\' }}\n                      />\n                    </PieChart>\n                  </ResponsiveContainer>\n                </div>\n                <div className=\"mt-4 space-y-2\">\n                  {MOCK_LOCATION_DATA.slice(0,4).map((loc, idx) => (\n                    <div key={loc.name} className=\"flex items-center justify-between text-sm\">\n                      <div className=\"flex items-center gap-2\">\n                        <div className=\"w-3 h-3 rounded-full\" style={{ backgroundColor: COLORS[idx] }}></div>\n                        <span className=\"text-gray-600 font-medium\">{loc.name}</span>\n                      </div>\n                      <span className=\"font-bold text-sepri-dark\">{loc.value.toLocaleString()}</span>\n                    </div>\n                  ))}\n                </div>\n              </div>\n            </div>\n\n            {/* Bottom Row */}\n            <div className=\"grid grid-cols-1 lg:grid-cols-2 gap-6\">\n              {/* Downloads Bar Chart */}\n              <div className=\"bg-white p-6 rounded-2xl border shadow-sm\">\n                <h3 className=\"font-bold text-lg mb-6 text-sepri-dark flex items-center gap-2\"><FileText size={20} className=\"text-sepri-medium\"/> Top Documentos Descargados</h3>\n                <div className=\"h-72 w-full\">\n                  <ResponsiveContainer width=\"100%\" height=\"100%\">\n                    <BarChart data={MOCK_DOWNLOADS_DATA} layout=\"vertical\" margin={{ top: 0, right: 0, left: 30, bottom: 0 }}>\n                      <CartesianGrid strokeDasharray=\"3 3\" horizontal={false} stroke=\"#E5E7EB\" />\n                      <XAxis type=\"number\" axisLine={false} tickLine={false} tick={{ fontSize: 12, fill: \'#6B7280\' }} />\n                      <YAxis dataKey=\"name\" type=\"category\" axisLine={false} tickLine={false} tick={{ fontSize: 11, fill: \'#374151\', fontWeight: 600 }} width={120} />\n                      <RechartsTooltip \n                        cursor={{fill: \'#F3F4F6\'}}\n                        contentStyle={{ borderRadius: \'12px\', border: \'none\', boxShadow: \'0 10px 15px -3px rgb(0 0 0 / 0.1)\' }}\n                      />\n                      <Bar dataKey=\"downloads\" name=\"Descargas\" fill=\"#164E87\" radius={[0, 6, 6, 0]} barSize={24} />\n                    </BarChart>\n                  </ResponsiveContainer>\n                </div>\n              </div>"
      replacement_content: "            {/* Top Cards */}\n            <div className=\"grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-4\">\n              <div className=\"bg-white p-6 rounded-2xl border shadow-sm flex flex-col justify-between\">\n                <div className=\"flex justify-between items-start mb-4\">\n                  <div className=\"p-3 bg-blue-50 text-blue-600 rounded-xl\"><Users size={24} /></div>\n                  <span className=\"text-xs font-bold text-green-500 bg-green-50 px-2 py-1 rounded-md\">Real</span>\n                </div>\n                <div>\n                  <h4 className=\"text-gray-500 text-sm font-medium\">Visitas Totales</h4>\n                  <p className=\"text-3xl font-black text-sepri-dark\">{totals.visits.toLocaleString()}</p>\n                </div>\n              </div>\n              <div className=\"bg-white p-6 rounded-2xl border shadow-sm flex flex-col justify-between\">\n                <div className=\"flex justify-between items-start mb-4\">\n                  <div className=\"p-3 bg-indigo-50 text-indigo-600 rounded-xl\"><Activity size={24} /></div>\n                  <span className=\"text-xs font-bold text-green-500 bg-green-50 px-2 py-1 rounded-md\">Real</span>\n                </div>\n                <div>\n                  <h4 className=\"text-gray-500 text-sm font-medium\">Usuarios \303\232nicos</h4>\n                  <p className=\"text-3xl font-black text-sepri-dark\">{totals.uniques.toLocaleString()}</p>\n                </div>\n              </div>\n              <div className=\"bg-white p-6 rounded-2xl border shadow-sm flex flex-col justify-between\">\n                <div className=\"flex justify-between items-start mb-4\">\n                  <div className=\"p-3 bg-orange-50 text-orange-600 rounded-xl\"><Clock size={24} /></div>\n                  <span className=\"text-xs font-bold text-green-500 bg-green-50 px-2 py-1 rounded-md\">Real</span>\n                </div>\n                <div>\n                  <h4 className=\"text-gray-500 text-sm font-medium\">Tiempo Promedio</h4>\n                  <p className=\"text-3xl font-black text-sepri-dark\">{totals.avgTime} <span className=\"text-sm font-medium text-gray-400\">min</span></p>\n                </div>\n              </div>\n              <div className=\"bg-white p-6 rounded-2xl border shadow-sm flex flex-col justify-between\">\n                <div className=\"flex justify-between items-start mb-4\">\n                  <div className=\"p-3 bg-green-50 text-green-600 rounded-xl\"><Download size={24} /></div>\n                  <span className=\"text-xs font-bold text-green-500 bg-green-50 px-2 py-1 rounded-md\">Real</span>\n                </div>\n                <div>\n                  <h4 className=\"text-gray-500 text-sm font-medium\">Descargas Totales</h4>\n                  <p className=\"text-3xl font-black text-sepri-dark\">{totals.totalDownloads.toLocaleString()}</p>\n                </div>\n              </div>\n            </div>\n\n            {/* Charts Row */}\n            <div className=\"grid grid-cols-1 lg:grid-cols-3 gap-6\">\n              {/* Main Traffic Chart */}\n              <div className=\"lg:col-span-2 bg-white p-6 rounded-2xl border shadow-sm\">\n                <h3 className=\"font-bold text-lg mb-6 text-sepri-dark\">Tr\303\241fico a lo largo del tiempo</h3>\n                <div className=\"h-80 w-full\">\n                  <ResponsiveContainer width=\"100%\" height=\"100%\">\n                    <AreaChart data={trafficData} margin={{ top: 10, right: 10, left: -20, bottom: 0 }}>\n                      <defs>\n                        <linearGradient id=\"colorVisitas\" x1=\"0\" y1=\"0\" x2=\"0\" y2=\"1\">\n                          <stop offset=\"5%\" stopColor=\"#164E87\" stopOpacity={0.3}/>\n                          <stop offset=\"95%\" stopColor=\"#164E87\" stopOpacity={0}/>\n                        </linearGradient>\n                        <linearGradient id=\"colorUnicos\" x1=\"0\" y1=\"0\" x2=\"0\" y2=\"1\">\n                          <stop offset=\"5%\" stopColor=\"#FFB000\" stopOpacity={0.3}/>\n                          <stop offset=\"95%\" stopColor=\"#FFB000\" stopOpacity={0}/>\n                        </linearGradient>\n                      </defs>\n                      <CartesianGrid strokeDasharray=\"3 3\" vertical={false} stroke=\"#E5E7EB\" />\n                      <XAxis dataKey=\"date\" axisLine={false} tickLine={false} tick={{ fontSize: 12, fill: \'#6B7280\' }} dy={10} />\n                      <YAxis axisLine={false} tickLine={false} tick={{ fontSize: 12, fill: \'#6B7280\' }} />\n                      <RechartsTooltip \n                        contentStyle={{ borderRadius: \'12px\', border: \'none\', boxShadow: \'0 10px 15px -3px rgb(0 0 0 / 0.1)\' }}\n                        labelStyle={{ fontWeight: \'bold\', color: \'#374151\', marginBottom: \'8px\' }}\n                      />\n                      <Area type=\"monotone\" dataKey=\"visitas\" name=\"Visitas\" stroke=\"#164E87\" strokeWidth={3} fillOpacity={1} fill=\"url(#colorVisitas)\" />\n                      <Area type=\"monotone\" dataKey=\"unicos\" name=\"Usuarios \303\232nicos\" stroke=\"#FFB000\" strokeWidth={3} fillOpacity={1} fill=\"url(#colorUnicos)\" />\n                    </AreaChart>\n                  </ResponsiveContainer>\n                </div>\n              </div>\n\n              {/* Locations Pie Chart */}\n              <div className=\"bg-white p-6 rounded-2xl border shadow-sm\">\n                <h3 className=\"font-bold text-lg mb-6 text-sepri-dark flex items-center gap-2\"><Map size={20} className=\"text-sepri-medium\"/> Origen del Tr\303\241fico</h3>\n                <div className=\"h-56 w-full\">\n                  <ResponsiveContainer width=\"100%\" height=\"100%\">\n                    <PieChart>\n                      <Pie\n                        data={locationData}\n                        cx=\"50%\"\n                        cy=\"50%\"\n                        innerRadius={60}\n                        outerRadius={80}\n                        paddingAngle={5}\n                        dataKey=\"value\"\n                      >\n                        {locationData.map((entry, index) => (\n                          <Cell key={`cell-${index}`} fill={COLORS[index % COLORS.length]} />\n                        ))}\n                      </Pie>\n                      <RechartsTooltip \n                        contentStyle={{ borderRadius: \'12px\', border: \'none\', boxShadow: \'0 10px 15px -3px rgb(0 0 0 / 0.1)\' }}\n                      />\n                    </PieChart>\n                  </ResponsiveContainer>\n                </div>\n                <div className=\"mt-4 space-y-2\">\n                  {locationData.length > 0 ? locationData.slice(0,4).map((loc, idx) => (\n                    <div key={loc.name} className=\"flex items-center justify-between text-sm\">\n                      <div className=\"flex items-center gap-2\">\n                        <div className=\"w-3 h-3 rounded-full\" style={{ backgroundColor: COLORS[idx] }}></div>\n                        <span className=\"text-gray-600 font-medium\">{loc.name}</span>\n                      </div>\n                      <span className=\"font-bold text-sepri-dark\">{loc.value.toLocaleString()}</span>\n                    </div>\n                  )) : <p className=\"text-center text-sm text-gray-400 mt-6\">Sin datos recientes</p>}\n                </div>\n              </div>\n            </div>\n\n            {/* Bottom Row */}\n            <div className=\"grid grid-cols-1 lg:grid-cols-2 gap-6\">\n              {/* Downloads Bar Chart */}\n              <div className=\"bg-white p-6 rounded-2xl border shadow-sm\">\n                <h3 className=\"font-bold text-lg mb-6 text-sepri-dark flex items-center gap-2\"><FileText size={20} className=\"text-sepri-medium\"/> Top Documentos Descargados</h3>\n                <div className=\"h-72 w-full\">\n                  <ResponsiveContainer width=\"100%\" height=\"100%\">\n                    <BarChart data={downloadsData} layout=\"vertical\" margin={{ top: 0, right: 0, left: 30, bottom: 0 }}>\n                      <CartesianGrid strokeDasharray=\"3 3\" horizontal={false} stroke=\"#E5E7EB\" />\n                      <XAxis type=\"number\" axisLine={false} tickLine={false} tick={{ fontSize: 12, fill: \'#6B7280\' }} />\n                      <YAxis dataKey=\"name\" type=\"category\" axisLine={false} tickLine={false} tick={{ fontSize: 11, fill: \'#374151\', fontWeight: 600 }} width={120} />\n                      <RechartsTooltip \n                        cursor={{fill: \'#F3F4F6\'}}\n                        contentStyle={{ borderRadius: \'12px\', border: \'none\', boxShadow: \'0 10px 15px -3px rgb(0 0 0 / 0.1)\' }}\n                      />\n                      <Bar dataKey=\"downloads\" name=\"Descargas\" fill=\"#164E87\" radius={[0, 6, 6, 0]} barSize={24} />\n                    </BarChart>\n                  </ResponsiveContainer>\n                  {downloadsData.length === 0 && <p className=\"text-center text-sm text-gray-400 mt-6 -translate-y-40\">Sin datos de descargas recientes</p>}\n                </div>\n              </div>"
    }
